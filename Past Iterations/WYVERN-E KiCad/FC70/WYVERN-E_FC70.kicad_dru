(version 1)
(rule "Fine-pitch escape U1" (condition "A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1')") (constraint clearance (min 0.1mm)))
(rule "Fine-pitch escape U2" (condition "A.intersectsCourtyard('U2') && B.intersectsCourtyard('U2')") (constraint clearance (min 0.1mm)))
(rule "Fine-pitch escape U5" (condition "A.intersectsCourtyard('U5') && B.intersectsCourtyard('U5')") (constraint clearance (min 0.1mm)))
(rule "Signal fine 3.9mil" (condition "A.NetClass == 'Default' && B.NetClass == 'Default'") (constraint clearance (min 0.1mm)))
(rule "INA226 sense pins" (condition "A.intersectsCourtyard('U4') || B.intersectsCourtyard('U4')") (constraint clearance (min 0.1mm)))
(rule "USB-C fan-out" (condition "A.intersectsCourtyard('USBC1') || B.intersectsCourtyard('USBC1') || A.intersectsCourtyard('D1') || B.intersectsCourtyard('D1')") (constraint clearance (min 0.1mm)))
(rule "Solid GND C29-2" (condition "A.Type == 'Pad' && A.memberOfFootprint('C29') && A.Pad_Number == '2'") (constraint zone_connection solid))
(rule "Solid GND C32-2" (condition "A.Type == 'Pad' && A.memberOfFootprint('C32') && A.Pad_Number == '2'") (constraint zone_connection solid))
(rule "Solid GND H1-14" (condition "A.Type == 'Pad' && A.memberOfFootprint('H1') && A.Pad_Number == '14'") (constraint zone_connection solid))
